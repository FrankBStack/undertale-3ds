# Observe UT release address/size guards without adding any linker pad or flag.
# A mismatch removes this build's ELF so a retry must relink and recheck it.
cmake_minimum_required(VERSION 3.19)
foreach(var ELF NM LIST)
    if(NOT DEFINED ${var} OR "${${var}}" STREQUAL "")
        message(FATAL_ERROR "check_ut_hot: -D${var}= is required")
    endif()
endforeach()

function(ut_hot_fail reason)
    file(REMOVE "${ELF}")
    message(FATAL_ERROR "UT hot guard: ${reason}; ELF removed. Audit against the frozen release before re-pinning.")
endfunction()

if(NOT EXISTS "${LIST}")
    ut_hot_fail("missing roster ${LIST}")
endif()
execute_process(COMMAND "${NM}" -n -S --defined-only "${ELF}"
    OUTPUT_VARIABLE symbols ERROR_VARIABLE nm_error RESULT_VARIABLE result TIMEOUT 30)
if(NOT result STREQUAL "0")
    string(STRIP "${nm_error}" nm_error)
    # Returning success preserves the linked ELF even under make's
    # delete-on-error rule. This is explicitly NOT a qualification PASS.
    message(STATUS "UT hot guard tool error: nm failed (${result}): ${nm_error}; NOT CHECKED, ELF retained")
    return()
endif()
string(REPLACE "\r" "" symbols "\n${symbols}\n")
string(REGEX REPLACE "\\.(isra|constprop|part)\\.[0-9]+" "" symbols "${symbols}")
file(STRINGS "${LIST}" entries)
set(count 0)
set(seen "")
set(moved "")
foreach(entry IN LISTS entries)
    if(entry MATCHES "^[ \t]*(#|$)")
        continue()
    endif()
    if(NOT entry MATCHES "^([0-9a-f]+) ([0-9a-f]+) ([tTwW]) ([A-Za-z0-9_.$]+)$")
        ut_hot_fail("malformed roster line ${entry}")
    endif()
    set(address "${CMAKE_MATCH_1}")
    set(size "${CMAKE_MATCH_2}")
    set(kind "${CMAKE_MATCH_3}")
    set(name "${CMAKE_MATCH_4}")
    string(REGEX REPLACE "\\.(isra|constprop|part)\\.[0-9]+" "" match_name "${name}")
    string(LENGTH "${address}" address_length)
    string(LENGTH "${size}" size_length)
    if(NOT address_length EQUAL 8 OR NOT size_length EQUAL 8 OR size STREQUAL "00000000")
        ut_hot_fail("invalid address/size for ${name}")
    endif()
    if(entry IN_LIST seen)
        ut_hot_fail("duplicate roster line ${entry}")
    endif()
    list(APPEND seen "${entry}")
    math(EXPR count "${count} + 1")
    string(FIND "${symbols}" "\n${address} ${size} ${kind} ${match_name}\n" found)
    if(found LESS 0)
        string(APPEND moved "\n  ${name}: expected ${address}/${size}/${kind}")
    endif()
endforeach()
if(count EQUAL 0)
    ut_hot_fail("empty roster ${LIST}")
endif()
if(moved)
    ut_hot_fail("address, size, type or presence changed:${moved}")
endif()
message(STATUS "UT hot guard: ${count} symbol placements keep release addresses and sizes")
