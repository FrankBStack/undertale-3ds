# Lab qualification only. No player build enables this by default.
option(CTRPORT_UT_HOTCHECK "Opt in to the audited release hot-symbol qualification check" OFF)
if("$ENV{CTRPORT_PLAYER_BUILD}" STREQUAL "1")
    # Also clear an old ON cache left by an earlier builder or lab checkout.
    set(CTRPORT_UT_HOTCHECK OFF CACHE BOOL "Opt in to the audited release hot-symbol qualification check" FORCE)
endif()

function(ut_hot_eligible output reason)
    set(${output} FALSE PARENT_SCOPE)
    set(${reason} "" PARENT_SCOPE)
    if(NOT CTRPORT_UT_HOTCHECK)
        return()
    endif()
    set(skip "")
    if(NOT CTRPORT_GAME STREQUAL "undertale")
        set(skip "different game")
    elseif(NOT CTRPORT_LAYOUT_PINS_ENABLED)
        set(skip "toolchain layout pins are disabled")
    elseif(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
        set(skip "not a Release build")
    elseif(NOT CTRPORT_DATA_SIZE STREQUAL "62921978" OR CTRPORT_GOG_COMPAT)
        set(skip "data row is not the audited Steam Windows 62921978 B row")
    elseif(NOT CTRPORT_RELEASE_SOURCE_URL)
        set(skip "no qualification source URL; use the standalone roster comparison for test builds")
    elseif(NOT CTRPORT_TYPED_AOT)
        set(skip "alternate layout: audited typed AOT is disabled")
    elseif((CTRPORT_TARGET STREQUAL "o3ds" AND NOT CTRPORT_ADPCM_SFXPACK)
           OR (CTRPORT_TARGET STREQUAL "n3ds" AND CTRPORT_ADPCM_SFXPACK))
        set(skip "alternate layout: ADPCM packing differs from the audited target")
    elseif(CTRPORT_PHASE_LAYOUT OR CTRPORT_PROFILE OR CTRPORT_HEAP_PROFILE OR CTRPORT_AOT_STRESS
           OR CTRPORT_MEMORY_CAP_KB OR CTRPORT_OPENH264_LINKED OR CTRPORT_REACH_GATE
           OR CTRPORT_PLAYER_SHOTS OR CTRPORT_TEST_LATE_PAGE OR CTRPORT_HALFART_FILE
           OR CTRPORT_FREEWINS OR CTRPORT_SPIKEREC OR CTRPORT_FRAMETRACE
           OR (DEFINED CTRPORT_WRITERFRONT_MODE AND NOT CTRPORT_WRITERFRONT_MODE STREQUAL "ON")
           OR NOT CTRPORT_DEBUG_RECORD_FAIL_AFTER STREQUAL "")
        set(skip "diagnostic or alternate layout")
    else()
        if(NOT EXISTS "${ut_hot_list}")
            message(FATAL_ERROR "Missing release hot-symbol qualification roster: ${ut_hot_list}")
        endif()
        file(STRINGS "${ut_hot_list}" headers REGEX "^# (Version|Release-URL|Data-size): ")
        foreach(key Version Release-URL Data-size)
            set(value "")
            foreach(line IN LISTS headers)
                if(line MATCHES "^# ${key}: (.+)$")
                    if(NOT value STREQUAL "")
                        message(FATAL_ERROR "Duplicate ${key} qualification roster header")
                    endif()
                    set(value "${CMAKE_MATCH_1}")
                endif()
            endforeach()
            if(value STREQUAL "")
                message(FATAL_ERROR "Missing ${key} qualification roster header")
            endif()
            set("roster_${key}" "${value}")
        endforeach()
        if(NOT roster_Data-size STREQUAL CTRPORT_DATA_SIZE)
            set(skip "data row differs from the qualification roster")
        elseif(NOT roster_Version STREQUAL RELEASE_VERSION OR NOT roster_Release-URL STREQUAL RELEASE_SOURCE_URL)
            set(skip "VERSION or release URL differs from the roster; integrate21 must regenerate after audit")
        endif()
    endif()
    if(skip)
        set(${reason} "${skip}" PARENT_SCOPE)
    else()
        set(${output} TRUE PARENT_SCOPE)
    endif()
endfunction()
