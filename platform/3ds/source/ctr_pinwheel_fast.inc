// Certified row spans with the exact scalar fallback at uncertain boundaries.
// pwFastBaseU is generated by the binary32 base-coordinate formula; original angle math stays.
static PW_SCENE_TEXT int pwFastDelta(int x,float first,float second) {
    volatile float u=pwFastBaseU[x];
    u=u+first;
    u=u-second;
    if (u<=0.0f) return 10000;
    if (u>=1.0f) return 10001;
    return (int)(((unsigned)(u*2097152.0f)*320u)>>21)-x;
}


static PW_SCENE_TEXT unsigned pwFastRows(CtrRenderer* r,C3D_Tex* tex,CtrColor color) {
    float angle=pwPinwheelValues[0],timestamp=pwPinwheelValues[1],wave=pwPinwheelValues[2];
    double a=((double)angle+120.0)*(3.14159265358979323846/180.0);
    double b=((double)angle+240.0)*(3.14159265358979323846/180.0);
    double nx[2]={-sin(a),sin(b)},ny[2]={cos(a),-cos(b)};
    unsigned quads=0;
    CtrColor cs[4]={color,color,color,color};
    for (int y=0;y<240;++y) {
        int lo=0,hi=320;
        for (unsigned n=0;n<2;++n) {
            double c=ny[n]*(120.0-(y+.5));
            if (fabs(nx[n])<1e-12) {if(c<0) hi=0;}
            else {
                double cut=159.5-c/nx[n];
                if(nx[n]>0 && cut>lo) lo=cut<320?(int)ceil(cut):320;
                if(nx[n]<0 && cut<hi-1) hi=cut>=0?(int)floor(cut)+1:0;
            }
        }
        if (hi<=lo) continue;
        while(lo>0 && pwSceneVisible(angle,lo-1,y)) --lo;
        while(lo<hi && !pwSceneVisible(angle,lo,y)) ++lo;
        while(hi<320 && pwSceneVisible(angle,hi,y)) ++hi;
        while(hi>lo && !pwSceneVisible(angle,hi-1,y)) --hi;
        float fy=(float)y+.5f;
        float first=(sinf(timestamp+fy*.125f)*.0025f)*wave;
        float second=(sinf(timestamp+fy*.075f)*.0025f)*wave;
        bool certified=false;
        int offset=0;
        if (isfinite(first) && isfinite(second) && fabsf(first)<=.00390625f && fabsf(second)<=.00390625f) {
            double z=.5+320.0*((double)first-(double)second);
            double lower=floor(z-.000244140625),upper=floor(z+.000244140625);
            certified=lower==upper;
            if (certified) offset=(int)lower;
        }
        for (int left=lo;left<hi;) {
            bool middle=certified && left>=3 && left<317;
            int delta=middle?offset:pwFastDelta(left,first,second);
            int right=middle?(hi<317?hi:317):left+1;
            while (right<hi) {
                middle=certified && right>=3 && right<317;
                int next=middle?offset:pwFastDelta(right,first,second);
                if (next!=delta) break;
                right=middle?(hi<317?hi:317):right+1;
            }
            float px[4]={(float)left,(float)right,(float)right,(float)left};
            float py[4]={(float)y,(float)y,(float)(y+1),(float)(y+1)};
            float u0=delta==10000?.5f:delta==10001?319.5f:(float)(left+delta);
            float u1=delta==10000?.5f:delta==10001?319.5f:(float)(right+delta);
            emitQuad(r,tex,px,py,u0/512.0f,(float)y/256.0f,u1/512.0f,(float)(y+1)/256.0f,cs);
            ++quads;left=right;
        }
    }
    return quads;
}
